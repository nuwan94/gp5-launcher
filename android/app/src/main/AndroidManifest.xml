<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- text-to-speech engines are hidden from apps targeting API 30+ unless declared -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".Gp5App"
        android:allowBackup="false"
        android:icon="@drawable/honda_logo_gold"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Gp5">

        <!-- The launcher: HOME + DEFAULT makes it selectable as the default home app.
             singleTask + stateNotNeeded is the standard launcher setup; the Home button
             brings this task back instead of stacking a new activity. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
