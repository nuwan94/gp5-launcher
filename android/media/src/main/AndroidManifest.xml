<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- GP5 Link: the phone app connects over Bluetooth (RFCOMM) with navigation and weather -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Equalizer: reads the sound playing (output mix) as frequency bands; nothing is recorded -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application>
        <!-- Notification access lets the launcher read other apps' media sessions (now playing). -->
        <service
            android:name="com.gp5.launcher.media.MediaListenerService"
            android:exported="true"
            android:label="GP5 Launcher now playing"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
